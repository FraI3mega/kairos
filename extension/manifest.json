{
  "manifest_version": 3,
  "name": "Kairos",
  "version": "0.1.0",
  "description": "Tells Kairos when you test your app on localhost, so it counts as focus time. Page addresses never leave your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1:24816/*"],
  "action": {
    "default_title": "Kairos",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
