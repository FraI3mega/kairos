# Copy to deploy/.env on the server and fill in. Never commit the real file.

# --- Required ---

# Password for the Postgres database (compose refuses to start without it).
POSTGRES_PASSWORD=change-me-long-random-string

# Public origin of the site: scheme and host only, no path. Compose refuses to start without it.
PUBLIC_URL=https://kairos.example.com

# Sign-in mode. Unset means hca. Use hca in production.
KAIROS_AUTH=hca

# Hack Club Auth app client ID. Required while KAIROS_AUTH=hca (the server fails to start without it).
# The Hack Club Auth app's redirect URI must be <PUBLIC_URL>/auth/callback.
HCA_CLIENT_ID=your-hca-client-id

# Hack Club Auth app client secret. Required while KAIROS_AUTH=hca.
HCA_CLIENT_SECRET=your-hca-client-secret

# --- Optional ---

# Lets KAIROS_AUTH=mock run off localhost (anyone can sign in as anyone). Unset means 0. Keep it 0.
KAIROS_ALLOW_MOCK_AUTH=0

# Hack Club Auth base URL. Unset means https://auth.hackclub.com.
HCA_URL=https://auth.hackclub.com

# Reverse proxies whose X-Forwarded-For is trusted: 1, loopback, or a comma list of IPs/CIDRs.
# Unset means 172.16.0.0/12 (the Docker bridge, where Caddy connects from).
KAIROS_TRUSTED_PROXY=172.16.0.0/12

# Host folder with the signed release tree, mounted read-only at /downloads. Unset means /srv/kairos/downloads.
# deploy/publish-release.sh writes to it too, via its own KAIROS_DOWNLOADS variable (same default).
KAIROS_DOWNLOADS_DIR=/srv/kairos/downloads

# Chrome Web Store page for the extension (https only). Unset means /extension hides the Chrome link.
KAIROS_CHROME_EXTENSION_URL=

# Firefox add-ons page for the extension (https only). Unset means /extension hides the Firefox link.
KAIROS_FIREFOX_EXTENSION_URL=

# Read-only GitHub token for the reviewers' GitHub check, which compares the commits a device saw with the repo. One token with no spaces.
# Unset means that page says the check is not set up and makes no GitHub calls.
KAIROS_GITHUB_TOKEN=

# 1 lets people delete their own account in settings. Unset or 0 means accounts are deleted on request,
# with docker exec kairos-app-1 kairos-server delete <username>.
KAIROS_SELF_DELETE=0
